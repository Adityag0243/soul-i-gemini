generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  USER
  ADMIN
}

enum Permission {
  GENERAL
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  ANONYMOUS
  MOBILE
}

enum TokenType {
  ACCESS
  REFRESH
  MAGIC_LINK
  RESET_PASSWORD
  EMAIL_VERIFICATION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum CrisisLevel {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum FeedbackType {
  BETTER
  SAME
  WORSE
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

//user and auth

model User {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String? @unique
  password String?
  status   Boolean @default(true)
  verified Boolean @default(false)

  // Profile (Phase 3 — D3 canonical user shape)
  callName       String?   @map("call_name") @db.VarChar(100)
  avatarUrl      String?   @map("avatar_url") @db.Text
  // ISO 3166-1 alpha-2 country code; IANA timezone; IETF BCP 47 locale.
  country        String?   @db.VarChar(2)
  timezone       String?   @db.VarChar(64)
  locale         String?   @db.VarChar(10)
  // DATE not TIMESTAMP — birthdays are timezone-agnostic.
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  gender         String?   @db.VarChar(50)
  // Default TTS voice the user prefers; AI service voice id.
  preferredVoice String?   @map("preferred_voice") @db.VarChar(100)

  // Notification opt-outs. Default ON — explicit opt-out model (D20).
  pushNotificationsEnabled  Boolean @default(true) @map("push_notifications_enabled")
  emailNotificationsEnabled Boolean @default(true) @map("email_notifications_enabled")

  // Onboarding gate + activity tracking (insights / cron / churn).
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  lastActiveAt        DateTime? @map("last_active_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  roles             UserRoleRelation[]
  keystores         Keystore[]
  authIdentities    AuthIdentity[]
  authTokens        AuthToken[]
  chatSessions      ChatSession[]
  emotionalStates   EmotionalState[]
  dailyCheckins     DailyCheckin[]
  practiceFeedbacks PracticeFeedback[]
  userSubscriptions UserSubscription[]
  payments          Payment[]
  crisisEvents      CrisisEvent[]
  referralsGiven    Referral[]         @relation("ReferrerRelation")
  referralsReceived Referral[]         @relation("ReferredRelation")
  analyticsEvents   AnalyticsEvent[]
  deviceTokens      UserDeviceToken[]

  @@index([email])
  @@map("users")
}

model UserRoleRelation {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")
  roleId Int @map("role_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_relations")
}

model Role {
  id     Int      @id @default(autoincrement())
  code   RoleCode @unique
  status Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  users UserRoleRelation[]

  @@index([code])
  @@map("roles")
}

// Auth Identities - stores all login providers per user
model AuthIdentity {
  id       String       @id @default(uuid()) @db.Uuid
  userId   Int          @map("user_id")
  provider AuthProvider

  // email provider fields
  email         String?
  passwordHash  String? @map("password_hash")
  emailVerified Boolean @default(false) @map("email_verified")

  // OAUTH provider fields (Google, Apple)
  providerAccountId String? @map("provider_account_id")

  // mobile provider fields (baad mein use karsakte hai)
  mobileNumber   String? @map("mobile_number") @db.VarChar(20)
  mobileVerified Boolean @default(false) @map("mobile_verified")

  // anonymous provider fields
  souliKeyHash String? @map("souli_key_hash")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider, email])
  @@index([provider, providerAccountId])
  @@index([provider, souliKeyHash])
  @@index([provider, mobileNumber])
  @@map("auth_identities")
}

// Auth Tokens - for magic links, password resets, etc.
model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  tokenType TokenType @map("token_type")
  expiresAt DateTime  @map("expires_at")
  revoked   Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@map("auth_tokens")
}

// Push notification device tokens.
// Token is unique across users — if a device changes hands the upsert at
// registration time re-points the row to the new userId. isActive=false on
// explicit logout so we can prune stale rows later.
model UserDeviceToken {
  id          String         @id @default(uuid()) @db.Uuid
  userId      Int            @map("user_id")
  token       String         @unique @db.VarChar(512)
  platform    DevicePlatform
  appVersion  String?        @map("app_version") @db.VarChar(50)
  deviceModel String?        @map("device_model") @db.VarChar(255)
  isActive    Boolean        @default(true) @map("is_active")
  lastSeenAt  DateTime?      @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("user_device_tokens")
}

// Keystore - JWT session management
model Keystore {
  id           Int     @id @default(autoincrement())
  clientId     Int     @map("client_id")
  primaryKey   String  @map("primary_key")
  secondaryKey String  @map("secondary_key")
  status       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, primaryKey, status])
  @@index([clientId, primaryKey, secondaryKey])
  @@map("keystores")
}

// API Keys for external integrations
model ApiKey {
  id          Int          @id @default(autoincrement())
  key         String       @unique
  version     Int          @default(1)
  permissions Permission[]
  comments    String[]
  status      Boolean      @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([key, status])
  @@map("api_keys")
}

// chat systems
model ChatSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     Int       @map("user_id")
  title      String?   @db.VarChar(255)
  isArchived Boolean   @default(false) @map("is_archived")
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")

  // AI session-level state (mirrored from latest assistant message; updated by chat.service on every AI reply).
  phase            String? @db.VarChar(50)
  energyNode       String? @map("energy_node") @db.VarChar(50)
  secondaryNode    String? @map("secondary_node") @db.VarChar(50)
  commitmentStatus String? @map("commitment_status") @db.VarChar(50)
  solutionStep     Int?    @map("solution_step")
  solutionComplete Boolean @default(false) @map("solution_complete")

  // Three-day task assigned by AI when solution_complete fires (Phase 13 webhook).
  // JSON blob shape: { title, description, durationDays, ... } — kept flexible to track AI changes.
  threeDayTask           Json?     @map("three_day_task")
  threeDayTaskAssignedAt DateTime? @map("three_day_task_assigned_at")

  // Activity tracking (used by Phase 9 cron auto-archive, Phase 11 insights).
  lastActivityAt DateTime? @map("last_activity_at")

  // Voice channel metadata. v1 is upload-based (D8); livekitRoomName is reserved for v1.1+.
  channelType     String? @map("channel_type") @db.VarChar(20)
  livekitRoomName String? @map("livekit_room_name") @db.VarChar(255)

  // Aggregates and free-tier signals.
  totalTokensUsed Int     @default(0) @map("total_tokens_used")
  mood            String? @db.VarChar(50)
  // Set true when user sends 3rd user message in this session (D12). Increments User.freeSessionsCompleted.
  isComplete      Boolean @default(false) @map("is_complete")

  createdAt DateTime @default(now()) @map("created_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        ChatMessage[]
  emotionalStates EmotionalState[]
  crisisEvents    CrisisEvent[]

  @@index([userId])
  @@index([userId, isArchived])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String      @id @default(uuid()) @db.Uuid
  sessionId   String      @map("session_id") @db.Uuid
  role        MessageRole
  content     String      @db.Text
  tokenCount  Int?        @map("token_count")
  crisisLevel CrisisLevel @default(NONE) @map("crisis_level")

  // AI metadata (set on ASSISTANT messages by chat.service when AI returns a reply).
  // All nullable: USER messages and pre-existing rows leave them null.
  // String (not enum) for phase/energyNode/secondaryNode so AI can add values without DB migration.
  phase           String? @db.VarChar(50)
  energyNode      String? @map("energy_node") @db.VarChar(50)
  secondaryNode   String? @map("secondary_node") @db.VarChar(50)
  nodeReasoning   String? @map("node_reasoning") @db.Text
  turnCount       Int?    @map("turn_count")
  solutionStep    Int?    @map("solution_step")
  ragSources      Json?   @map("rag_sources")
  detectedEmotion String? @map("detected_emotion") @db.VarChar(100)

  // Voice metadata (set on USER messages that were transcribed from audio,
  // and on ASSISTANT messages that have synthesized audio).
  audioUrl   String? @map("audio_url") @db.Text
  durationMs Int?    @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")

  session      ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  crisisEvents CrisisEvent[]

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// EMOTIONAL SYSTEM

model EmotionalState {
  id              String  @id @default(uuid()) @db.Uuid
  userId          Int     @map("user_id")
  sessionId       String? @map("session_id") @db.Uuid
  detectedEmotion String  @map("detected_emotion") @db.VarChar(100)
  energyNodeId    String? @map("energy_node_id") @db.Uuid
  intensity       Int?

  createdAt DateTime @default(now()) @map("created_at")

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  energyNode EnergyNode?  @relation(fields: [energyNodeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@map("emotional_states")
}

model DailyCheckin {
  id         String  @id @default(uuid()) @db.Uuid
  userId     Int     @map("user_id")
  moodScore  Int     @map("mood_score")
  energyWord String? @map("energy_word") @db.VarChar(100)
  reflection String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("daily_checkins")
}

// RAG KNOWLEDGE / PRACTICES

model EnergyNode {
  id          String  @id @default(uuid()) @db.Uuid
  title       String  @db.VarChar(255)
  description String? @db.Text
  version     Int     @default(1)
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  practices       Practice[]
  emotionalStates EmotionalState[]

  @@index([isActive])
  @@map("energy_nodes")
}

model Practice {
  id              String  @id @default(uuid()) @db.Uuid
  energyNodeId    String? @map("energy_node_id") @db.Uuid
  title           String  @db.VarChar(255)
  durationMinutes Int?    @map("duration_minutes")
  textScript      String? @map("text_script") @db.Text
  audioUrl        String? @map("audio_url") @db.Text
  videoUrl        String? @map("video_url") @db.Text
  version         Int     @default(1)
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  energyNode EnergyNode?        @relation(fields: [energyNodeId], references: [id], onDelete: SetNull)
  feedbacks  PracticeFeedback[]

  @@index([energyNodeId])
  @@index([isActive])
  @@map("practices")
}

model PracticeFeedback {
  id         String       @id @default(uuid()) @db.Uuid
  userId     Int          @map("user_id")
  practiceId String       @map("practice_id") @db.Uuid
  feedback   FeedbackType
  reflection String?      @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([practiceId])
  @@map("practice_feedbacks")
}

// SUBSCRIPTIONS

model SubscriptionPlan {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @db.VarChar(100)
  priceUsd       Decimal @map("price_usd") @db.Decimal(10, 2)
  stripePriceId  String? @map("stripe_price_id") @db.VarChar(255)
  razorpayPlanId String? @map("razorpay_plan_id") @db.VarChar(255)
  chatLimit      Int?    @map("chat_limit")
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  userSubscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 Int                @map("user_id")
  planId                 String             @map("plan_id") @db.Uuid
  provider               PaymentProvider?
  providerSubscriptionId String?            @map("provider_subscription_id") @db.VarChar(255)
  status                 SubscriptionStatus @default(FREE)
  currentPeriodEnd       DateTime?          @map("current_period_end")

  createdAt DateTime @default(now()) @map("created_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("user_subscriptions")
}

// PAYMENTS

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  userId            Int             @map("user_id")
  provider          PaymentProvider
  providerPaymentId String?         @map("provider_payment_id") @db.VarChar(255)
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @db.VarChar(10)
  status            PaymentStatus   @default(PENDING)
  rawWebhook        Json?           @map("raw_webhook")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider, providerPaymentId])
  @@map("payments")
}

// CRISIS SYSTEM

model CrisisEvent {
  id               String      @id @default(uuid()) @db.Uuid
  userId           Int         @map("user_id")
  sessionId        String?     @map("session_id") @db.Uuid
  level            CrisisLevel
  triggerMessageId String?     @map("trigger_message_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  triggerMessage ChatMessage? @relation(fields: [triggerMessageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@map("crisis_events")
}

// REFERRALS

model Referral {
  id             String @id @default(uuid()) @db.Uuid
  referrerUserId Int    @map("referrer_user_id")
  referredUserId Int?   @map("referred_user_id")
  code           String @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")

  referrer User  @relation("ReferrerRelation", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User? @relation("ReferredRelation", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@unique([code])
  @@index([referrerUserId])
  @@index([referredUserId])
  @@map("referrals")
}

// ANALYTICS

model AnalyticsEvent {
  id        String @id @default(uuid()) @db.Uuid
  userId    Int?   @map("user_id")
  eventName String @map("event_name") @db.VarChar(100)
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventName])
  @@index([createdAt])
  @@map("analytics_events")
}
